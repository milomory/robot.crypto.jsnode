{
  "name": "robot.crypto.jsnode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:ui",
    "dev:api": "tsx watch src/server.ts",
    "dev:ui": "vite --config ui/vite.config.ts --host 127.0.0.1 --port 5173",
    "build": "npm run build:api && npm run build:ui",
    "build:api": "tsc -p tsconfig.json",
    "build:ui": "vite build --config ui/vite.config.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:status": "tsx src/scripts/db-status.ts",
    "lab:markets": "tsx src/scripts/market-lab.ts",
    "lab:observe": "tsx src/scripts/market-observe.ts"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "lucide-react": "^0.468.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.61.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
