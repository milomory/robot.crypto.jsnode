#!/usr/bin/python3 -I
"""Fixed recovery capture only. No caller paths, commands, environment or orders.

The observer and recovery locks cover no-key preflight, capture and exact-CID
cleanup. The observer-state mount permits file writes; pinned code restricts its
use to cooldowns. This is not a filesystem capability limited to one file.
"""
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import select
import signal
import stat
import subprocess
import sys
import time

IMAGE = 'sha256:404c49b93e47f2eacecd16448ad73e021bf7f5edb621721f545667e8a58e9c08'
BASE = Path('/home/mil/crypto-order-recovery')
OBSERVER_STATE = Path('/home/mil/crypto-pair-observer/state')
DOCKER = '/usr/bin/docker'
UID = 1002
NAME = 'crypto-order-recovery-readonly'
LABEL = 'crypto-order-recovery.release'
REQUEST_LABEL = 'crypto-order-recovery.request'
ENTRYPOINT = 'dist/scripts/protected-order-recovery.js'
MAX_OUTPUT = 4096
FAILURE = {'schema': 1, 'error': 'recovery-failed'}
PREFLIGHT_SECONDS = 10
RUN_SECONDS = 40
CLEANUP_SECONDS = 10
MAX_FILES = 4096
MAX_TOTAL = 32 * 1024 * 1024


def unique_pairs(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError()
        result[key] = value
    return result


def reject_constant(_value):
    raise ValueError()


def decode(raw):
    return json.loads(raw.decode('utf-8'), object_pairs_hook=unique_pairs, parse_constant=reject_constant)


def sha(value):
    return hashlib.sha256(value).hexdigest()


def is_hash(value):
    return type(value) is str and re.fullmatch('[a-f0-9]{64}', value) is not None


def private_directory(path):
    info = path.lstat()
    if (path.resolve() != path or not stat.S_ISDIR(info.st_mode)
            or info.st_uid != UID or stat.S_IMODE(info.st_mode) != 0o700):
        raise ValueError()


def read_private(path, bound, executable=False):
    descriptor = os.open(str(path), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(descriptor, 'rb') as source:
        info = os.fstat(source.fileno())
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != UID or info.st_nlink != 1
                or stat.S_IMODE(info.st_mode) != (0o700 if executable else 0o600) or info.st_size > bound):
            raise ValueError()
        raw = source.read(bound + 1)
        if len(raw) > bound:
            raise ValueError()
        return raw


def safe_name(name):
    return (type(name) is str and len(name) <= 240 and re.fullmatch('[A-Za-z0-9_./-]+', name)
            and not name.startswith('/') and all(part not in ('', '.', '..') for part in name.split('/')))


def verify_release(release):
    if release.parent != BASE / 'releases' or not is_hash(release.name):
        raise ValueError()
    for directory in (BASE, BASE / 'releases', release):
        private_directory(directory)
    raw = read_private(release / 'manifest.json', 512 * 1024)
    if sha(raw) != release.name:
        raise ValueError()
    manifest = decode(raw)
    if (type(manifest) is not dict or not 3 <= len(manifest) <= MAX_FILES
            or not {'run-once', 'package.json', ENTRYPOINT}.issubset(manifest)
            or any(not safe_name(name) or name == 'manifest.json' or not is_hash(value) for name, value in manifest.items())):
        raise ValueError()
    observed = set()
    total = 0
    expected_dirs = set()
    for name in manifest:
        parts = name.split('/')
        expected_dirs.update('/'.join(parts[:i]) for i in range(1, len(parts)))
    seen_dirs = set()
    for directory, dirs, files in os.walk(str(release), followlinks=False):
        parent = Path(directory)
        private_directory(parent)
        for name in dirs:
            child = parent / name
            private_directory(child)
            relative_dir = str(child.relative_to(release))
            if relative_dir not in expected_dirs:
                raise ValueError()
            seen_dirs.add(relative_dir)
        for name in files:
            child = parent / name
            relative = str(child.relative_to(release))
            if relative == 'manifest.json':
                continue
            if relative not in manifest:
                raise ValueError()
            content = read_private(child, 8 * 1024 * 1024, relative == 'run-once')
            total += len(content)
            if total > MAX_TOTAL or sha(content) != manifest[relative]:
                raise ValueError()
            observed.add(relative)
    if observed != set(manifest) or seen_dirs != expected_dirs:
        raise ValueError()


def verify_request(request_digest):
    root = BASE / 'requests' / request_digest
    for directory in (BASE / 'requests', root, root / 'journal'):
        private_directory(directory)
    if {item.name for item in root.iterdir()} != {'request.json', 'journal'}:
        raise ValueError()
    raw = read_private(root / 'request.json', 16 * 1024)
    if sha(raw) != request_digest:
        raise ValueError()
    value = decode(raw)
    if type(value) is not dict or value.get('venue') not in ('mexc', 'okx'):
        raise ValueError()
    # Full canonical schema, TTL, replay and eligibility are checked by the fixed
    # network-none preflight. No request field supplies a path or Docker option.
    return root, value['venue']


def locked_file(path, create=False):
    descriptor = os.open(str(path), os.O_RDWR | os.O_NOFOLLOW | (os.O_CREAT if create else 0), 0o600)
    try:
        info = os.fstat(descriptor)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != UID or info.st_nlink != 1
                or stat.S_IMODE(info.st_mode) != 0o600):
            raise ValueError()
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return os.fdopen(descriptor, 'r+')
    except Exception:
        os.close(descriptor)
        raise


def command(args, deadline):
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise TimeoutError()
    return subprocess.run(args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                          stderr=subprocess.DEVNULL, timeout=min(3, remaining), check=False)


def absent_container(deadline, identity=None):
    selector = 'id=' + identity if identity else 'name=^/' + NAME + '$'
    result = command([DOCKER, 'ps', '--all', '--quiet', '--no-trunc', '--filter', selector], deadline)
    return result.returncode == 0 and not result.stdout.strip()


def cleanup_container(cidfile, release_digest, request_digest, deadline):
    if cidfile.exists() or cidfile.is_symlink():
        identity = read_private(cidfile, 65).decode('ascii').strip()
        if not is_hash(identity):
            raise ValueError()
        template = '{{.Id}} {{ index .Config.Labels "' + LABEL + '" }} {{ index .Config.Labels "' + REQUEST_LABEL + '" }}'
        result = command([DOCKER, 'inspect', '--format', template, identity], deadline)
        if result.returncode == 0:
            if result.stdout.strip() != (' '.join((identity, release_digest, request_digest))).encode('ascii'):
                raise ValueError()
            if command([DOCKER, 'rm', '-f', identity], deadline).returncode != 0:
                raise RuntimeError()
        if not absent_container(deadline, identity) or not absent_container(deadline):
            raise RuntimeError()
        cidfile.unlink()
    elif not absent_container(deadline):
        raise RuntimeError()


def decode_report(raw, request_digest, selected_venue, preflight):
    if not 0 < len(raw) <= MAX_OUTPUT:
        raise ValueError()
    value = decode(raw)
    if type(value) is not dict or type(value.get('schema')) is not int or value['schema'] != 1:
        raise ValueError()
    fields = {'schema', 'mode', 'requestSha256', 'venue', 'executable', 'captureProvenanceVerified', 'accountIdentityVerified'}
    fields.update({'ready'} if preflight else {'reportWritten', 'requestCount', 'receipt'})
    if (set(value) != fields or value['requestSha256'] != request_digest or value['venue'] != selected_venue
            or value['mode'] != ('order-recovery-preflight' if preflight else 'order-recovery-readonly')
            or any(value[field] is not False for field in ('executable', 'captureProvenanceVerified', 'accountIdentityVerified'))):
        raise ValueError()
    if preflight:
        if value['ready'] is not True:
            raise ValueError()
    else:
        receipt = value['receipt']
        if (value['reportWritten'] is not True or type(value['requestCount']) is not int or value['requestCount'] != 3
                or type(receipt) is not dict or set(receipt) != {'schema', 'kind', 'archiveId', 'archiveHash'}
                or type(receipt['schema']) is not int or receipt['schema'] != 1
                or receipt['kind'] != 'live-order-recovery-archive-receipt' or not is_hash(receipt['archiveHash'])
                or type(receipt['archiveId']) is not str
                or re.fullmatch('[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}', receipt['archiveId']) is None):
            raise ValueError()
    return value


def bounded_output(process, seconds):
    deadline = time.monotonic() + seconds
    output = bytearray()
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError()
        ready, _, _ = select.select([process.stdout], [], [], remaining)
        if not ready:
            raise TimeoutError()
        chunk = os.read(process.stdout.fileno(), min(4096, MAX_OUTPUT - len(output) + 1))
        if not chunk:
            break
        output.extend(chunk)
        if len(output) > MAX_OUTPUT:
            raise ValueError()
    process.wait(timeout=max(.001, deadline - time.monotonic()))
    if process.returncode != 0:
        raise ValueError()
    return bytes(output)


def docker_arguments(release, request, cidfile, preflight):
    args = [DOCKER, 'run', '--rm', '-i', '--pull=never', '--name', NAME,
            '--cidfile', str(cidfile), '--label', LABEL + '=' + release.name,
            '--label', REQUEST_LABEL + '=' + request.name, '--log-driver=none', '--read-only',
            '--cap-drop=ALL', '--security-opt=no-new-privileges:true', '--user=1002:27',
            '--pids-limit=64', '--memory=256m', '--cpus=0.5', '--ulimit=core=0',
            '--network=' + ('none' if preflight else 'bridge'), '--tmpfs=/tmp:rw,noexec,nosuid,size=16m',
            '--mount', 'type=bind,src=' + str(release) + ',dst=/code,readonly',
            '--mount', 'type=bind,src=' + str(request) + ',dst=/request,readonly',
            '--mount', 'type=bind,src=' + str(request / 'journal') + ',dst=/journal,readonly',
            '--mount', 'type=bind,src=' + str(BASE / 'state') + ',dst=/state' + (',readonly' if preflight else ''),
            '--mount', 'type=bind,src=' + str(OBSERVER_STATE) + ',dst=/observer-state' + (',readonly' if preflight else ''),
            '--workdir=/code', IMAGE, 'node', '--disable-proto=throw', ENTRYPOINT,
            '--request-digest', request.name]
    return args + (['--preflight'] if preflight else [])


def run_phase(release, request, selected_venue, preflight):
    if not absent_container(time.monotonic() + 3):
        raise ValueError()
    cidfile = BASE / 'state' / ('.container-' + str(os.getpid()))
    if cidfile.exists() or cidfile.is_symlink():
        raise ValueError()
    process = None
    try:
        process = subprocess.Popen(docker_arguments(release, request, cidfile, preflight),
                                   stdin=subprocess.DEVNULL if preflight else sys.stdin.buffer,
                                   stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, start_new_session=True)
        value = decode_report(bounded_output(process, PREFLIGHT_SECONDS if preflight else RUN_SECONDS), request.name, selected_venue, preflight)
    finally:
        prior = []
        for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            prior.append((sig, signal.signal(sig, signal.SIG_IGN)))
        deadline = time.monotonic() + CLEANUP_SECONDS
        try:
            try:
                if process is not None and process.poll() is None:
                    process.kill()
                    process.wait(timeout=min(1, max(.001, deadline - time.monotonic())))
            finally:
                cleanup_container(cidfile, release.name, request.name, deadline)
        finally:
            if process is not None and process.stdout is not None:
                process.stdout.close()
            for sig, handler in prior:
                signal.signal(sig, handler)
    return value


def main():
    args = sys.argv[1:]
    preflight = len(args) == 2 and args[0] == '--preflight'
    if os.getuid() != UID or not ((len(args) == 1 or preflight) and is_hash(args[-1])):
        raise ValueError()
    release = Path(__file__).resolve().parent
    verify_release(release)
    request, selected_venue = verify_request(args[-1])
    private_directory(BASE / 'state')
    private_directory(OBSERVER_STATE)
    with locked_file(OBSERVER_STATE / '.observer.lock'), locked_file(BASE / 'state' / '.recovery.lock', create=True):
        value = run_phase(release, request, selected_venue, True)
        if not preflight:
            # Recheck pinned bytes before passing the credential stream. TS repeats
            # time/head/eligibility checks after bounded stdin has been collected.
            verify_release(release)
            verify_request(args[-1])
            value = run_phase(release, request, selected_venue, False)
        print(json.dumps(value, separators=(',', ':')))


def interrupted(_signal, _frame):
    raise InterruptedError()


if __name__ == '__main__':
    os.umask(0o077)
    for selected_signal in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(selected_signal, interrupted)
    try:
        main()
    except Exception:
        print(json.dumps(FAILURE, separators=(',', ':')))
        sys.exit(1)
