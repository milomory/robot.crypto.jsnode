NODE_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=3000

# Local access expects an SSH tunnel:
# ssh -N -L 3580:127.0.0.1:3580 igorjan94.ru
DB_HOST=127.0.0.1
DB_PORT=3580
DB_NAME=robot_crypto
DB_USER=crypto_robot_app
DB_PASSWORD=
DB_SSL=false

DASHBOARD_AUTH_ENABLED=false
DASHBOARD_USERNAME=robot
DASHBOARD_PASSWORD=

EXCHANGE_ID=binance
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
QUOTE_CURRENCY=USDT
TRADING_MODE=paper
LIVE_TRADING_LOCKED=true

RISK_MAX_ORDER_QUOTE=50
RISK_DAILY_QUOTE_BUDGET=250
RISK_MAX_DAILY_LOSS_QUOTE=30
RISK_MAX_OPEN_POSITIONS=5
RISK_MAX_SYMBOL_EXPOSURE_QUOTE=150
RISK_MAX_SPREAD_PERCENT=0.25
PAPER_FEE_PERCENT=0.1

AUTO_PAPER_TRADER_ENABLED=false
AUTO_PAPER_TRADER_INTERVAL_MS=60000
AUTO_PAPER_ORDER_QUOTE=10
AUTO_PAPER_MIN_24H_CHANGE_PERCENT=0.5
AUTO_PAPER_TAKE_PROFIT_PERCENT=2
AUTO_PAPER_STOP_LOSS_PERCENT=1.5
AUTO_PAPER_ALLOW_FALLBACK_MARKET_DATA=false
AUTO_PAPER_RECORD_OBSERVATIONS=false
